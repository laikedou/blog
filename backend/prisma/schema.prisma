generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  username  String    @unique
  password  String
  displayName String  @default("")
  bio       String    @default("")
  avatar    String    @default("")
  role      String    @default("user") // user | admin
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts                  Post[]
  comments               Comment[]
  media                  Media[]
  visualizations         Visualization[]
  visualizationLikes     VisualizationLike[]
  visualizationComments  VisualizationComment[]
  commentLikes           CommentLike[]
  tutorInteractions      TutorInteraction[]
  classrooms             Classroom[]             @relation("TeacherClassrooms")
  classroomParticipants  ClassroomParticipant[]
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  content     String    @default("")
  excerpt     String    @default("")
  featuredImage String  @default("")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  viewCount   Int       @default(0)

  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  tags        PostTag[]
  comments    Comment[]
  banners     Banner[]

  seoTitle       String @default("")
  seoDescription String @default("")
  aiGenerated    Boolean @default(false)
  aiPrompt       String  @default("")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  description String  @default("")
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  status    String    @default("approved") // approved | pending | spam
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  postId    Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])

  parentId   Int?
  parent     Comment?       @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]      @relation("CommentReplies")
  likes      CommentLike[]
  likesCount Int            @default(0)
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Media {
  id          Int       @id @default(autoincrement())
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  altText     String    @default("")
  createdAt   DateTime  @default(now())

  uploaderId  Int
  uploader    User      @relation(fields: [uploaderId], references: [id])

  folderId    Int?
  folder      MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model MediaFolder {
  id        Int       @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    MediaFolder? @relation("FolderChildren", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderChildren")
  media     Media[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CrawlSource {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  interval   Int      // minutes between runs
  status     String   @default("active") // active | paused
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  articles   CrawledArticle[]
}

model CrawledArticle {
  id             Int         @id @default(autoincrement())
  sourceId       Int
  source         CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceUrl      String      @unique
  title          String
  content        String
  excerpt        String      @default("")
  authorName     String      @default("")
  publishedDate  DateTime?
  imageUrl       String      @default("")
  isProcessed    Boolean     @default(false) // has been polished by AI
  isPublished    Boolean     @default(false) // has been saved as a Post
  postId         Int?        // linked Post id after publication
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Banner {
  id          Int       @id @default(autoincrement())
  title       String    @default("")
  subtitle    String    @default("")
  imageUrl    String
  linkUrl     String    @default("")
  postId      Int?      // link to featured post
  post        Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  zone        String    @default("hero") // hero | sidebar | inline | footer
  startDate   DateTime?
  endDate     DateTime?
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChatMessage {
  id          Int       @id @default(autoincrement())
  sessionId   String    // anonymous session identifier
  role        String    // user | assistant
  content     String
  createdAt   DateTime  @default(now())
}

model Feedback {
  id          Int       @id @default(autoincrement())
  sessionId   String
  name        String    @default("")
  email       String    @default("")
  message     String
  pageUrl     String    @default("")
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

// ─── SEO Module ──────────────────────────────────────────────

model SeoKeyword {
  id          Int       @id @default(autoincrement())
  keyword     String
  source      String    @default("manual") // manual | ai-suggested | google | baidu
  volume      Int       @default(0)       // search volume estimate
  difficulty  Int       @default(0)       // 0-100 ranking difficulty
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rankings    SeoKeywordRanking[]
}

model SeoKeywordRanking {
  id          Int       @id @default(autoincrement())
  keywordId   Int
  keyword     SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position    Int       @default(0)       // 0 = not ranked
  page        String    @default("")      // URL path where keyword is tracked
  source      String    @default("manual") // google | baidu | manual
  checkedAt   DateTime  @default(now())
}

model SeoAudit {
  id          Int       @id @default(autoincrement())
  postId      Int?
  pageUrl     String    @default("")        // URL audited
  score       Int       @default(0)         // 0-100 SEO score
  title       String    @default("")
  titleLength Int       @default(0)
  description String    @default("")
  descLength  Int       @default(0)
  wordCount   Int       @default(0)
  hasImage    Boolean   @default(false)
  imageAlt    String    @default("")
  hasCanonical Boolean  @default(false)
  hasOgTags   Boolean   @default(false)
  hasTwitterCard Boolean @default(false)
  hasJsonLd   Boolean   @default(false)
  hasH1       Boolean   @default(false)
  h1Count     Int       @default(0)
  keywordDensity Float   @default(0.0)
  readability Float    @default(0.0)      // Flesch-Kincaid score
  suggestions String    @default("")      // JSON array of suggestions
  createdAt   DateTime  @default(now())
}

model SeoIndexStatus {
  id          Int       @id @default(autoincrement())
  pageUrl     String    @unique
  googleIndexed Boolean  @default(false)
  baiduIndexed  Boolean  @default(false)
  lastChecked  DateTime  @default(now())
  errors      String    @default("")      // JSON array of indexing errors
}

model SeoClick {
  id          Int       @id @default(autoincrement())
  postId      Int?
  pageUrl     String    @default("")
  source      String    @default("direct") // google | baidu | direct | social | other
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0.0)
  avgPosition Float     @default(0.0)
  recordedAt  DateTime  @default(now())
}

// ─── Site Configuration (Singleton) ─────────────────────────

model SiteConfig {
  id              Int      @id @default(autoincrement())
  siteTitle       String   @default("AI Blog")
  siteTagline     String   @default("")
  siteDescription String   @default("")
  adminTitle      String   @default("Blog Admin")
  logoUrl         String   @default("")
  faviconUrl      String   @default("")
  footerText      String   @default("")
  copyrightText   String   @default("")
  contactEmail    String   @default("")
  socialLinks     String   @default("{}")        // JSON: { "twitter": "...", "github": "...", ... }
  seoHomeTitle    String   @default("")
  seoHomeDescription String @default("")
  postsPerPage    Int      @default(10)
  enableComments  Boolean  @default(true)
  customHeadHtml        String   @default("")
  privacyPolicyContent  String   @default("")
  termsOfUseContent     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Error Log ──────────────────────────────────────────────

model ErrorLog {
  id         Int       @id @default(autoincrement())
  method     String    // GET | POST | PUT | DELETE | PATCH
  url        String    // request path
  statusCode Int       // HTTP status code
  message    String    // error message
  stack      String    @default("") // stack trace (truncated)
  body       String    @default("") // request body (JSON string, truncated)
  userId     Int?      // authenticated user id if available
  createdAt  DateTime  @default(now())
}

// ─── Visualization (AI-generated interactive animations) ─────

model Visualization {
  id                  Int       @id @default(autoincrement())
  title               String
  subject             String    // math | physics
  description         String    @default("")
  introduction        String    @default("")       // brief introduction/overview of the concept
  detailedExplanation String    @default("")       // in-depth explanation of the visualization topic
  knowledgeSummary    String    @default("")       // key knowledge points summary
  articleMode        Boolean   @default(false)    // Feature 5: interactive article mode
  quiz               String    @default("")       // JSON: [{ question, options[], correctIndex, explanation }]
  difficultyLevels   String    @default("")       // JSON: { beginner: <id>, intermediate: <id>, advanced: <id> }
  isDifficultyRoot   Boolean   @default(false)    // Feature 4: parent of difficulty variants
  tags                String    @default("")       // comma-separated
  featuredImage       String    @default("")       // AI-generated cover image URL
  htmlContent         String                      // the generated HTML code
  prompt              String    @default("")       // the original user prompt
  status              String    @default("draft")  // draft | published
  version             Int       @default(1)
  viewCount           Int       @default(0)
  interactCount       Int       @default(0)
  likesCount          Int       @default(0)

  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions              VisualizationVersion[]
  stats                 VisualizationStat[]
  likes                 VisualizationLike[]
  comments              VisualizationComment[]
  tutorInteractions     TutorInteraction[]
  classrooms            Classroom[]
  narrationScripts      NarrationScript[]
  experimentPerspectives ExperimentPerspective[]
}

model VisualizationVersion {
  id              Int            @id @default(autoincrement())
  visualizationId Int
  visualization   Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  htmlContent       String
  prompt          String         @default("")
  changeNote      String         @default("")
  version         Int
  createdAt       DateTime       @default(now())
}

model VisualizationStat {
  id               Int            @id @default(autoincrement())
  visualizationId  Int
  visualization    Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  action           String         // view | interact | share
  metadata         String         @default("{}") // JSON metadata
  createdAt        DateTime       @default(now())
}

model VisualizationLike {
  id               Int            @id @default(autoincrement())
  visualizationId  Int
  visualization    Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([visualizationId, userId])
}

model TutorInteraction {
  id               Int            @id @default(autoincrement())
  visualizationId  Int
  visualization    Visualization  @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  userId           Int?
  user             User?          @relation(fields: [userId], references: [id])
  sessionId        String
  interactionType  String         // param_change | button_click | question
  parameterName    String         @default("")
  parameterValue   String         @default("")
  aiResponse       String
  createdAt        DateTime       @default(now())
}

model VisualizationComment {
  id               Int            @id @default(autoincrement())
  content          String
  status           String         @default("approved") // approved | pending | spam
  visualizationId  Int
  visualization    Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  authorId         Int
  author           User          @relation(fields: [authorId], references: [id])
  parentId         Int?
  parent           VisualizationComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies          VisualizationComment[] @relation("CommentReplies")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}


// ─── Classroom (Feature 2) ─────────────────────────────────────

model Classroom {
  id              Int       @id @default(autoincrement())
  name            String
  joinCode        String    @unique
  visualizationId Int
  visualization   Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  teacherId       Int
  teacher         User      @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  status          String    @default("active")  // active | ended
  settings        String    @default("{}")      // JSON: { allowStudentControl, muteAll }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  participants    ClassroomParticipant[]
}

model ClassroomParticipant {
  id           Int       @id @default(autoincrement())
  classroomId  Int
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  role         String    @default("student")  // teacher | student
  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  @@unique([classroomId, userId])
}

// ─── Narration (Feature 3) ─────────────────────────────────────

model NarrationScript {
  id              Int       @id @default(autoincrement())
  visualizationId Int
  visualization   Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  locale          String    // zh-CN | zh-TW | en | ja
  title           String    @default("")
  segments        String    // JSON: [{ startTime, endTime, text, cuePoint }]
  fullText        String
  audioUrl        String    @default("")
  generatedAt     DateTime  @default(now())
  version         Int       @default(1)

  @@unique([visualizationId, locale])
}

// ─── Experiments (Feature 6) ────────────────────────────────────

model ExperimentGroup {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @default("")
  concept     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  perspectives ExperimentPerspective[]
}

model ExperimentPerspective {
  id              Int       @id @default(autoincrement())
  groupId         Int
  group           ExperimentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  visualizationId Int
  visualization   Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  perspectiveName String
  subtitle        String    @default("")
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
}

model AiUsageLog {
  id               Int       @id @default(autoincrement())
  provider         String
  model            String
  feature          String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  totalTokens      Int       @default(0)
  durationMs       Int       @default(0)
  status           String    @default("success")
  errorMessage     String?
  userId           Int?
  createdAt        DateTime  @default(now())
}

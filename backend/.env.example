# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production

# DeepSeek AI (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Standard model: deepseek-chat (fast), Pro/reasoning model: deepseek-reasoner (slow, may need higher timeout)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Increase timeout for reasoning models (default 120000ms = 2min)
DEEPSEEK_TIMEOUT_MS=180000

# Visualization AI Providers
# Shared timeout for all AI providers (Gemini, Grok, OpenAI, Claude). Default 120000ms = 2min
AI_TIMEOUT_MS=180000
# Max output tokens for AI providers. Default 65536 (64k, near max context for most models)
AI_MAX_TOKENS=65536
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=
GROK_MODEL=grok-4-3
# Grok image generation (for banner/cover AI generation)
GROK_IMAGE_MODEL=grok-4-3
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_MS=120000
# Optional: OPENAI_API_KEY=   ANTHROPIC_API_KEY=

# xAI TTS (narration audio generation)
XAI_API_KEY=

# LiveKit (WebRTC) — free tier at livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000

# Database (SQLite)
DATABASE_URL=file:./dev.db
